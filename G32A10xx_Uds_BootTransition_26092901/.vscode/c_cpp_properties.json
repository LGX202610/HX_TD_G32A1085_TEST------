{
  "version": 4,
  "configurations": [
    {
      "name": "G32A1085_BootTransition",
      "includePath": [
        "${workspaceFolder}/Application/include",
        "${workspaceFolder}/Driver/include",
        "${workspaceFolder}/Hal/include",
        "${workspaceFolder}/Libraries/CMSIS/Include",
        "${workspaceFolder}/Libraries/Device/include",
        "${workspaceFolder}/Libraries/G32A10xx_StdPeriphDriver/inc",
        "${workspaceFolder}/Uds/auto_lib/inc",
        "${workspaceFolder}/Uds/FIFO/inc",
        "${workspaceFolder}/Uds/Flash/inc",
        "${workspaceFolder}/Uds/Port/inc",
        "${workspaceFolder}/Uds/TP/inc",
        "${workspaceFolder}/Uds/UDS/inc",
        "${workspaceFolder}/Uds/Verify/inc"
      ],
      "defines": [
        "G32A1085",
        "G32A10xx",
        "G32A10x_SERIES",
        "START_FROM_FLASH",
        "TURN_ON_CPU0",
        "UDS_PROJECT_FOR_BOOTLOADER",
        "__GNUC__",
        "__ARM_ARCH_6M__=1",
        "ARM_MATH_CM0PLUS"
      ],
      "cStandard": "c99",
      "cppStandard": "c++11",
      "intelliSenseMode": "gcc-arm",
      "compileCommands": "${workspaceFolder}/compile_commands.json",
      "browse": {
        "path": [
          "${workspaceFolder}/Application",
          "${workspaceFolder}/Driver",
          "${workspaceFolder}/Hal",
          "${workspaceFolder}/Libraries",
          "${workspaceFolder}/Uds",
          "${workspaceFolder}/Project/MDK"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ]
}
